{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puuid",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // src/server.ts wraps Start's default entry to redirect www to the apex.
  "main": "src/server.ts",
  // The apex is the index of every other *.puuid.com site.
  "routes": [
    {
      "pattern": "puuid.com",
      "custom_domain": true,
    },
    // Served by the same Worker, which 301s it to the apex (see src/server.ts).
    {
      "pattern": "www.puuid.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
