{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puuid",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // The apex is the index of every other *.puuid.com site. Cloudflare points
  // it at Vercel today, so the first deploy has to take the record over.
  "routes": [
    {
      "pattern": "puuid.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
